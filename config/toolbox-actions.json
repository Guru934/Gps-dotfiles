{
  "version": 1,
  "actions": {
    "lock_screen": {
      "name": "Lock Screen",
      "category": "Desktop",
      "purpose": "Locks the current desktop session immediately.",
      "executable": ["${GPS_ROOT}/scripts/gps-lock"],
      "confirm": true,
      "destructive": false,
      "risk": "medium",
      "assistant_allowed": true,
      "ui_only": false,
      "timeout": 10
    },
    "open_terminal": {
      "name": "Open Terminal",
      "category": "Applications",
      "purpose": "Opens a new Kitty terminal emulator window.",
      "executable": ["kitty"],
      "confirm": false,
      "destructive": false,
      "risk": "safe",
      "assistant_allowed": true,
      "ui_only": false,
      "timeout": 5
    },
    "open_browser": {
      "name": "Open Browser",
      "category": "Applications",
      "purpose": "Opens the Brave web browser.",
      "executable": ["brave"],
      "confirm": false,
      "destructive": false,
      "risk": "safe",
      "assistant_allowed": true,
      "ui_only": false,
      "timeout": 5
    },
    "open_dev_ws": {
      "name": "Open Development Workspace",
      "category": "Development",
      "purpose": "Opens VS Code, Kitty terminal, and Brave browser for development.",
      "executable": ["code"],
      "confirm": false,
      "destructive": false,
      "risk": "safe",
      "assistant_allowed": true,
      "ui_only": false,
      "timeout": 5
    },
    "focus_start": {
      "name": "Start Focus Session",
      "category": "Desktop",
      "purpose": "Toggles an Island focus timer session.",
      "executable": ["${GPS_ROOT}/scripts/gps-ipc", "island", "focusToggle"],
      "confirm": false,
      "destructive": false,
      "risk": "safe",
      "assistant_allowed": true,
      "ui_only": false,
      "timeout": 5
    },
    "audio_controls": {
      "name": "Audio Controls",
      "category": "Audio",
      "purpose": "Opens the Media Hub audio panel.",
      "executable": ["${GPS_ROOT}/scripts/gps-ipc", "mediahub", "toggle"],
      "confirm": false,
      "destructive": false,
      "risk": "safe",
      "assistant_allowed": true,
      "ui_only": true,
      "timeout": 5
    },
    "open_media_hub": {
      "name": "Open Media Hub",
      "category": "Media",
      "purpose": "Toggles the GPS Media Hub drawer.",
      "executable": ["${GPS_ROOT}/scripts/gps-ipc", "mediahub", "toggle"],
      "confirm": false,
      "destructive": false,
      "risk": "safe",
      "assistant_allowed": true,
      "ui_only": true,
      "timeout": 5
    },
    "scrcpy_launch": {
      "name": "Launch scrcpy",
      "category": "Phone & Devices",
      "purpose": "Starts screen mirroring with active display and audio forwarding.",
      "executable": ["scrcpy", "--turn-screen-off", "--stay-awake"],
      "confirm": true,
      "destructive": false,
      "risk": "medium",
      "assistant_allowed": true,
      "ui_only": false,
      "timeout": 5
    },
    "set_volume": {
      "name": "Set Volume",
      "category": "Audio",
      "purpose": "Sets the default audio output volume percentage (0-100).",
      "executable": ["wpctl", "set-volume", "@DEFAULT_AUDIO_SINK@", "${level}%"],
      "param_schema": {
        "level": "^([0-9]{1,2}|100)$"
      },
      "confirm": false,
      "destructive": false,
      "risk": "safe",
      "assistant_allowed": true,
      "ui_only": true,
      "timeout": 5
    },
    "set_brightness": {
      "name": "Set Brightness",
      "category": "Display",
      "purpose": "Sets the display brightness percentage (1-100).",
      "executable": ["brightnessctl", "set", "${percent}%"],
      "param_schema": {
        "percent": "^([1-9][0-9]?|100)$"
      },
      "confirm": false,
      "destructive": false,
      "risk": "safe",
      "assistant_allowed": true,
      "ui_only": true,
      "timeout": 5
    },
    "dnd_enable": {
      "name": "Enable Do Not Disturb",
      "category": "Desktop",
      "purpose": "Toggles Do Not Disturb mode for notifications.",
      "executable": ["${GPS_ROOT}/scripts/gps-ipc", "notify", "dnd", "toggle"],
      "confirm": false,
      "destructive": false,
      "risk": "safe",
      "assistant_allowed": true,
      "ui_only": true,
      "timeout": 5
    },
    "notify": {
      "name": "Send Notification",
      "category": "Desktop",
      "purpose": "Dispatches a desktop notification.",
      "executable": ["notify-send", "-a", "GPS Toolbox", "${title}", "${message}"],
      "param_schema": {
        "title": "^[A-Za-z0-9 _.,!?:'-]{1,128}$",
        "message": "^[A-Za-z0-9 _.,!?:'\\n-]{0,256}$"
      },
      "confirm": false,
      "destructive": false,
      "risk": "safe",
      "assistant_allowed": true,
      "ui_only": false,
      "timeout": 5
    },
    "show_reminder": {
      "name": "Show Reminder",
      "category": "Desktop",
      "purpose": "Shows an urgent desktop reminder notification.",
      "executable": ["notify-send", "-u", "critical", "-a", "GPS Reminder", "Reminder", "${message}"],
      "param_schema": {
        "message": "^[A-Za-z0-9 _.,!?:'\\n-]{1,256}$"
      },
      "confirm": false,
      "destructive": false,
      "risk": "safe",
      "assistant_allowed": true,
      "ui_only": false,
      "timeout": 5
    },
    "screenshot": {
      "name": "Capture Region",
      "category": "Desktop",
