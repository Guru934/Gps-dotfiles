      "confirm": true,
      "destructive": true,
      "risk": "destructive",
      "assistant_allowed": false,
      "ui_only": false,
      "grace": 30,
      "timeout": 10
    },
    "reboot": {
      "name": "Reboot",
      "category": "Power",
