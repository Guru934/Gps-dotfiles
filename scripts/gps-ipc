#!/usr/bin/env bash
set -euo pipefail

# Unified IPC router for GPS Desktop
REPO_DIR="${GPS_ROOT:-$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)}"
BACKEND_FILE="${XDG_CONFIG_HOME:-$HOME/.config}/quickshell/gps-island-backend"

get_backend() {
    if [[ -f "$BACKEND_FILE" ]]; then
        cat "$BACKEND_FILE" 2>/dev/null | tr -d '[:space:]'
    else
        echo "gps"
    fi
}

cmd="${1:-}"
shift || true

case "$cmd" in
    shell)
        target="${1:-}"
        action="${2:-}"
        shift 2 || true
        if [[ -z "$target" || -z "$action" ]]; then
            echo "Usage: gps-ipc shell <target> <action> [args...]" >&2
            exit 1
        fi
        exec quickshell ipc -p "$REPO_DIR/shell.qml" call "$target" "$action" "$@"
        ;;
    settings)
        action="${1:-toggle}"
        shift || true
        if ! quickshell ipc -p "$REPO_DIR/settings.qml" call settings "$action" "$@" 2>/dev/null; then
            nohup quickshell --no-duplicate -p "$REPO_DIR/settings.qml" >/dev/null 2>&1 &
        fi
        ;;
    island)
        action="${1:-}"
        shift || true
        if [[ -z "$action" ]]; then
            echo "Usage: gps-ipc island <show|hide|pin|unpin|status|action> [args...]" >&2
            exit 1
        fi
        backend="$(get_backend)"
        if [[ "$backend" == "tide" ]]; then
            exec quickshell ipc -p "$HOME/.local/share/tide-island" call island "$action" "$@"
        else
            exec quickshell ipc -p "$REPO_DIR/island/IslandProduction.qml" call island "$action" "$@"
        fi
        ;;
    clipboard|clip)
        action="${1:-toggle}"
        shift || true
        backend="$(get_backend)"
        if [[ "$backend" == "tide" ]]; then
            exec quickshell ipc -p "$HOME/.local/share/tide-island" call clipboard "$action" "$@"
        else
            exec quickshell ipc -p "$REPO_DIR/island/IslandProduction.qml" call island clipboard "$action" "$@"
        fi
        ;;
    *)
        echo "Usage: gps-ipc <shell|settings|island|clipboard> [args...]" >&2
        echo "  shell <target> <action> [args...]" >&2
        echo "  settings [action] [args...]" >&2
        echo "  island <show|hide|pin|unpin|status|action> [args...]" >&2
        echo "  clipboard [action]" >&2
        exit 1
        ;;
esac
