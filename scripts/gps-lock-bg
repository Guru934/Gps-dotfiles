#!/usr/bin/env python3
"""Rotate lock-screen background from user image collection.

Manages rotating backgrounds for hyprlock without modifying desktop wallpaper
or theme color pipelines.
"""
from __future__ import annotations

import argparse
import json
import os
from pathlib import Path
import random
import sys
import tempfile
from typing import Any

VALID_EXTENSIONS = {".jpg", ".jpeg", ".png", ".webp"}


def get_default_collection_dir() -> Path:
    env_dir = os.environ.get("GPS_LOCK_BG_DIR")
    if env_dir:
        return Path(env_dir).expanduser().resolve()
    return Path.home() / "Pictures" / "Lockscreen-Background"


def get_default_conf_path() -> Path:
    env_conf = os.environ.get("GPS_LOCK_BG_CONF")
    if env_conf:
        return Path(env_conf).expanduser().resolve()
    xdg_config = os.environ.get("XDG_CONFIG_HOME")
    base = Path(xdg_config).expanduser() if xdg_config else Path.home() / ".config"
    return base / "hypr" / "lock-bg.conf"


def get_default_state_path() -> Path:
    env_state = os.environ.get("GPS_LOCK_BG_STATE")
    if env_state:
        return Path(env_state).expanduser().resolve()
    xdg_state = os.environ.get("XDG_STATE_HOME")
    base = Path(xdg_state).expanduser() if xdg_state else Path.home() / ".local" / "state"
    return base / "gps" / "last-lock-bg.txt"


def atomic_write(target_path: Path, content: str) -> None:
    target_path.parent.mkdir(parents=True, exist_ok=True)
    target_dir = target_path.parent
    with tempfile.NamedTemporaryFile("w", dir=target_dir, delete=False, encoding="utf-8") as tf:
        tf.write(content)
        tmp_name = tf.name
    os.replace(tmp_name, target_path)


def scan_images(collection_dir: Path) -> list[Path]:
    """Scan directory for valid, readable image files with supported extensions."""
    if not collection_dir.exists() or not collection_dir.is_dir():
        return []
    valid: list[Path] = []
    try:
        for entry in collection_dir.iterdir():
            try:
                if not entry.is_file():
                    continue
                if entry.suffix.lower() not in VALID_EXTENSIONS:
                    continue
                if not os.access(entry, os.R_OK):
                    continue
                valid.append(entry.resolve())
            except (OSError, PermissionError):
                continue
    except (OSError, PermissionError):
        return []
    valid.sort(key=lambda p: str(p))
    return valid


def read_last_used(state_path: Path) -> str | None:
    try:
        if state_path.is_file() and os.access(state_path, os.R_OK):
            last = state_path.read_text(encoding="utf-8").strip()
            return last or None
    except OSError:
        pass
    return None


def record_last_used(state_path: Path, image_path: Path) -> None:
    try:
        atomic_write(state_path, f"{image_path.resolve()}\n")
    except OSError:
        pass


def select_image(
    images: list[Path],
    last_used: str | None = None,
    force_image: Path | None = None,
    seed: int | None = None,
    deterministic: bool = False,
) -> Path | None:
    """Select the next background image avoiding immediate repeat."""
    if force_image:
        if force_image.is_file() and os.access(force_image, os.R_OK):
            return force_image.resolve()
        return None

    if not images:
        return None

    if len(images) == 1:
        return images[0]

    # Filter out immediate repeat if possible
    candidates = [img for img in images if str(img) != last_used]
    if not candidates:
        candidates = images

    if deterministic:
        return candidates[0]

    if seed is not None:
        rng = random.Random(seed)
        return rng.choice(candidates)

    return random.choice(candidates)


def update_lock_bg_conf(
    conf_path: Path,
    selected_image: Path | None,
    collection_dir: Path,
) -> None:
    """Atomically write hyprlock lock-bg.conf."""
    if selected_image is not None:
        content = (
            "# Generated by scripts/gps-lock-bg — do not edit by hand.\n"
            f"$wallpaper = {selected_image}\n"
        )
    else:
        content = (
            "# Generated by scripts/gps-lock-bg — do not edit by hand.\n"
            f"# No valid images found in {collection_dir}\n"
            "# Retaining wallpaper from lock-colors.conf or hyprlock fallback\n"
        )
    try:
        atomic_write(conf_path, content)
    except (OSError, PermissionError):
        pass


def rotate_background(
    collection_dir: Path | None = None,
    conf_path: Path | None = None,
    state_path: Path | None = None,
    force_image: Path | None = None,
    seed: int | None = None,
    deterministic: bool = False,
    dry_run: bool = False,
) -> dict[str, Any]:
    coll_dir = collection_dir or get_default_collection_dir()
    c_path = conf_path or get_default_conf_path()
    s_path = state_path or get_default_state_path()

    # Automatically ensure collection directory exists
    try:
        coll_dir.mkdir(parents=True, exist_ok=True)
    except OSError:
        pass

    images = scan_images(coll_dir)
    last_used = read_last_used(s_path)

    # Check environment variables for deterministic mode or test overrides
    if not deterministic and os.environ.get("GPS_LOCK_BG_DETERMINISTIC") in ("1", "true", "yes"):
        deterministic = True
    if seed is None and os.environ.get("GPS_LOCK_BG_SEED"):
        try:
            seed = int(os.environ["GPS_LOCK_BG_SEED"])
        except ValueError:
            pass
    if not force_image and os.environ.get("GPS_LOCK_BG_FORCE"):
        force_image = Path(os.environ["GPS_LOCK_BG_FORCE"])

    chosen = select_image(
        images=images,
        last_used=last_used,
        force_image=force_image,
        seed=seed,
        deterministic=deterministic,
    )

    if not dry_run:
        update_lock_bg_conf(c_path, chosen, coll_dir)
        if chosen is not None:
            record_last_used(s_path, chosen)

    return {
        "ok": True,
        "collection_dir": str(coll_dir),
        "total_images": len(images),
        "last_used": last_used,
        "selected": str(chosen) if chosen else None,
        "conf_path": str(c_path),
        "state_path": str(s_path),
        "dry_run": dry_run,
    }


def main() -> int:
    parser = argparse.ArgumentParser(description="Rotate GPS lock-screen background")
    parser.add_argument("--dir", type=Path, help="Override background collection directory")
    parser.add_argument("--conf", type=Path, help="Override output hyprlock background conf path")
    parser.add_argument("--state", type=Path, help="Override state file path")
    parser.add_argument("--force", type=Path, help="Force a specific image")
    parser.add_argument("--seed", type=int, help="Deterministic random seed for testing")
    parser.add_argument("--deterministic", action="store_true", help="Deterministic selection mode")
    parser.add_argument("--dry-run", action="store_true", help="Select without writing files")
    parser.add_argument("--status", action="store_true", help="Print status as JSON")

    args = parser.parse_args()

    dry_run = args.dry_run or args.status

    res = rotate_background(
        collection_dir=args.dir,
        conf_path=args.conf,
        state_path=args.state,
        force_image=args.force,
        seed=args.seed,
        deterministic=args.deterministic,
        dry_run=dry_run,
    )

    if args.status:
        print(json.dumps(res, indent=2))
    elif res["selected"]:
        print(res["selected"])
    else:
        # Fallback case, printed to stderr for clarity if running directly
        sys.stderr.write("No rotating background selected (fallback active)\n")

    return 0


if __name__ == "__main__":
    sys.exit(main())
