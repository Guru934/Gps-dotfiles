#!/usr/bin/env python3
"""GPS Sound CLI - Single entry point for GPS Desktop sound notifications.

Usage:
  gps-sound play <event> [--dedupe <key>] [--file <path>] [--force]
  gps-sound list
  gps-sound test <event>
  gps-sound mute
  gps-sound unmute
  gps-sound status
"""

import argparse
import json
import os
import sys
from pathlib import Path

# Add script directory to sys.path
sys.path.insert(0, str(Path(__file__).resolve().parent))
import sound_engine


KNOWN_EVENTS = [
    "notification",
    "critical",
    "notification-critical",
    "agent-permission",
    "agent-permission-reminder",
    "agent-done",
    "agent-error",
    "reminder",
    "download-done",
    "download-failed",
    "error",
    "tick",
    "shutter",
    "record-start",
    "record-stop",
    "lock",
    "unlock",
    "battery-low",
    "plug",
    "unplug",
    "device-connect",
    "device-disconnect",
    "dnd-on",
    "dnd-off",
]


def cmd_play(args: argparse.Namespace) -> int:
    engine = sound_engine.SoundEngine()
    custom_file = None
    if args.file:
        p = Path(args.file)
        if not sound_engine.is_allowed_sound_file(p):
            if not args.quiet:
                print(f"Error: Sound file {args.file} is not under an allowed directory.", file=sys.stderr)
            return 1
        custom_file = p

    played, reason = engine.play(
        event=args.event,
        custom_dedupe_key=args.dedupe,
        custom_sound_file=custom_file,
        bypass_filters=args.force,
    )
    if not args.quiet and not played:
        # Normal suppression shouldn't exit with error, but report reason if verbose
        if args.verbose:
            print(f"Sound '{args.event}' not played: {reason}")
    return 0 if played else 0


def cmd_test(args: argparse.Namespace) -> int:
    engine = sound_engine.SoundEngine()
    decision = engine.evaluate(args.event, bypass_filters=True)
    if not decision.allowed:
        print(f"Test failed for '{args.event}': {decision.reason}")
        return 1
    print(f"Testing sound: {args.event}")
    print(f"  Sound file:  {decision.sound_file}")
    print(f"  Volume:      {decision.volume:.2f}")

    played, reason = engine.play(args.event, bypass_filters=True)
    if played:
        print(f"  Result:      Playback initiated ({reason})")
        return 0
    else:
        print(f"  Result:      Playback failed ({reason})")
        return 1


def cmd_list(args: argparse.Namespace) -> int:
    cfg = sound_engine.load_settings()
    theme = cfg.get("theme", "default")
    events_cfg = cfg.get("events", {})
    master_vol = float(cfg.get("volume", 0.8))
    vol_cap = float(cfg.get("volumeCap", 1.0))

    print(f"GPS Sound Theme: {theme} (Master Vol: {master_vol:.2f}, Cap: {vol_cap:.2f}, Muted: {cfg.get('muted', False)})\n")
    print(f"{'Event':<26} {'Enabled':<10} {'Volume':<10} {'File'}")
    print("-" * 80)

    for event in KNOWN_EVENTS:
        ev_cfg = events_cfg.get(event, {})
        enabled = ev_cfg.get("enabled", True) if isinstance(ev_cfg, dict) else True
        vol = ev_cfg.get("volume", 1.0) if isinstance(ev_cfg, dict) else 1.0
        eff_vol = min(master_vol * vol, vol_cap, 1.0)
        file_path = sound_engine.resolve_sound_file(event, theme_name=theme)
        file_str = file_path.name if file_path else "<none>"
        print(f"{event:<26} {str(enabled):<10} {eff_vol:<10.2f} {file_str}")
    return 0


def cmd_mute(args: argparse.Namespace) -> int:
    ok = sound_engine.save_settings({"muted": True})
    if ok:
        print("Sound muted.")
        return 0
    print("Failed to save settings.", file=sys.stderr)
    return 1


def cmd_unmute(args: argparse.Namespace) -> int:
    ok = sound_engine.save_settings({"muted": False})
    if ok:
        print("Sound unmuted.")
        return 0
    print("Failed to save settings.", file=sys.stderr)
    return 1


def cmd_status(args: argparse.Namespace) -> int:
    cfg = sound_engine.load_settings()
    dnd = sound_engine.is_dnd_active()
    mic = sound_engine.is_mic_in_use()

    info = {
        "enabled": cfg.get("enabled", True),
        "muted": cfg.get("muted", False),
        "volume": cfg.get("volume", 0.8),
        "volumeCap": cfg.get("volumeCap", 1.0),
        "theme": cfg.get("theme", "default"),
        "soundsBypassDnd": cfg.get("soundsBypassDnd", True),
        "quietWhileMicInUse": cfg.get("quietWhileMicInUse", True),
        "dndActive": dnd,
        "micInUse": mic,
    }

    if args.json:
        print(json.dumps(info, indent=2))
    else:
        print("=== GPS Sound Status ===")
        print(f"Enabled:              {info['enabled']}")
        print(f"Muted:                {info['muted']}")
        print(f"Master Volume:        {info['volume']:.2f} (Cap: {info['volumeCap']:.2f})")
        print(f"Theme:                {info['theme']}")
        print(f"DND Active:           {info['dndActive']} (Bypass: {info['soundsBypassDnd']})")
        print(f"Microphone in use:    {info['micInUse']} (Quiet: {info['quietWhileMicInUse']})")
    return 0


def main() -> int:
    parser = argparse.ArgumentParser(description="GPS Sound System CLI")
    subparsers = parser.add_subparsers(dest="command", required=True)

    # play
    p_play = subparsers.add_parser("play", help="Play a sound event")
    p_play.add_argument("event", help="Event name to play")
    p_play.add_argument("--dedupe", help="Custom deduplication key")
    p_play.add_argument("--file", help="Path to sound file (must be under allowed dir)")
    p_play.add_argument("--force", action="store_true", help="Bypass rate limit, DND, mic checks")
    p_play.add_argument("-v", "--verbose", action="store_true", help="Verbose output")
    p_play.add_argument("-q", "--quiet", action="store_true", help="Quiet output")

    # test
    p_test = subparsers.add_parser("test", help="Test playback of an event")
    p_test.add_argument("event", help="Event name to test")

    # list
    p_list = subparsers.add_parser("list", help="List known events and mappings")

    # mute / unmute
    subparsers.add_parser("mute", help="Mute all notification sounds")
    subparsers.add_parser("unmute", help="Unmute notification sounds")

    # status
    p_status = subparsers.add_parser("status", help="Show current sound system status")
    p_status.add_argument("--json", action="store_true", help="Output JSON")

    args = parser.parse_args()

    if args.command == "play":
        return cmd_play(args)
    elif args.command == "test":
        return cmd_test(args)
    elif args.command == "list":
        return cmd_list(args)
    elif args.command == "mute":
        return cmd_mute(args)
    elif args.command == "unmute":
        return cmd_unmute(args)
    elif args.command == "status":
        return cmd_status(args)

    return 0


if __name__ == "__main__":
    sys.exit(main())
