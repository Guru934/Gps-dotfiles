#!/usr/bin/env bash
# ============================================================================
# gps-lock — Unified lock wrapper for Aetheric Shell / GPS
# Single entry point for Super+L, Power Menu, and Control Center
# ============================================================================
set -euo pipefail

SCRIPT_DIR="$(dirname "$(realpath "$0")")"
REPO_DIR="$(cd "${SCRIPT_DIR}/.." && pwd)"
export GPS_ROOT="${GPS_ROOT:-$REPO_DIR}"

# 1. Prevent duplicate lock instances safely
if pidof hyprlock >/dev/null 2>&1; then
    exit 0
fi

# 2. Resolve hyprlock executable
resolve_hyprlock() {
    if command -v hyprlock >/dev/null 2>&1; then
        command -v hyprlock
        return 0
    fi
    local candidates=(
        "${HOME}/.local/bin/hyprlock"
        "${HOME}/.local/opt/hyprlock/bin/hyprlock"
        "/usr/local/bin/hyprlock"
        "/usr/bin/hyprlock"
    )
    for cand in "${candidates[@]}"; do
        if [ -x "$cand" ]; then
            printf '%s\n' "$cand"
            return 0
        fi
    done
    return 1
}

LOCK_BIN=""
if ! LOCK_BIN="$(resolve_hyprlock)"; then
    echo "ERROR: hyprlock executable not found in PATH or standard user directories." >&2
    if command -v notify-send >/dev/null 2>&1; then
        notify-send -u critical "Lock Failed" "hyprlock executable was not found."
    fi
    exit 127
fi

# 3. Resolve verified lock configuration
resolve_config() {
    local candidates=(
        "${XDG_CONFIG_HOME:-$HOME/.config}/hypr/hyprlock.conf"
        "$(dirname "$(realpath "$0")")/../dots/hypr/hyprlock.conf"
    )
    for cfg in "${candidates[@]}"; do
        if [ -r "$cfg" ]; then
            printf '%s\n' "$cfg"
            return 0
        fi
    done
    return 1
}

CONFIG_FILE=""
if ! CONFIG_FILE="$(resolve_config)"; then
    echo "ERROR: hyprlock configuration not found." >&2
    if command -v notify-send >/dev/null 2>&1; then
        notify-send -u critical "Lock Failed" "hyprlock.conf configuration file was not found."
    fi
    exit 1
fi

# 4. Ensure lock colors exist or deploy fallback from repository
LOCK_COLORS="${XDG_CONFIG_HOME:-$HOME/.config}/hypr/lock-colors.conf"
if [ ! -f "$LOCK_COLORS" ]; then
    FALLBACK_COLORS="$(dirname "$(realpath "$0")")/../dots/hypr/lock-colors.conf"
    if [ -f "$FALLBACK_COLORS" ]; then
        mkdir -p "$(dirname "$LOCK_COLORS")"
        cp -n "$FALLBACK_COLORS" "$LOCK_COLORS" 2>/dev/null || true
    fi
fi

# 4b. Ensure lock background config exists or deploy fallback from repository
LOCK_BG="${XDG_CONFIG_HOME:-$HOME/.config}/hypr/lock-bg.conf"
if [ ! -f "$LOCK_BG" ]; then
    FALLBACK_BG="$(dirname "$(realpath "$0")")/../dots/hypr/lock-bg.conf"
    if [ -f "$FALLBACK_BG" ]; then
        mkdir -p "$(dirname "$LOCK_BG")"
        cp -n "$FALLBACK_BG" "$LOCK_BG" 2>/dev/null || true
    fi
fi

# 4c. Select rotating background if available
# If lock-bg.conf already exists, rotate asynchronously in background for the next lock
BG_ROTATOR="$(dirname "$(realpath "$0")")/gps-lock-bg"
if [ -x "$BG_ROTATOR" ]; then
    if [ -s "$LOCK_BG" ]; then
        ( "$BG_ROTATOR" >/dev/null 2>&1 & )
    else
        "$BG_ROTATOR" >/dev/null 2>&1 || true
    fi
fi

# 4d. Resolve the lock-screen profile picture (round avatar beside the name).
# Generated per-user state in ~/.config/gps/lock-avatar.conf.
AVATAR_TOOL="${SCRIPT_DIR}/gps-lock-avatar"
LOCK_AVATAR_CONF="${XDG_CONFIG_HOME:-$HOME/.config}/gps/lock-avatar.conf"

# Safe migration: if an old symlink exists in ~/.config/hypr/lock-avatar.conf, remove it
LEGACY_AVATAR_CONF="${XDG_CONFIG_HOME:-$HOME/.config}/hypr/lock-avatar.conf"
if [ -L "$LEGACY_AVATAR_CONF" ]; then
    rm -f "$LEGACY_AVATAR_CONF" 2>/dev/null || true
fi

# Check if LOCK_AVATAR_CONF exists and points to a valid readable avatar image
avatar_valid=0
if [ -s "$LOCK_AVATAR_CONF" ]; then
    avatar_path="$( (grep -E '^\$avatar\s*=\s*' "$LOCK_AVATAR_CONF" 2>/dev/null || true) | head -1 | sed -E 's/^\$avatar\s*=\s*//; s/[[:space:]]+$//')"
    if [ -n "$avatar_path" ] && [ -r "$avatar_path" ] && [ -s "$avatar_path" ]; then
        avatar_valid=1
    fi
fi

if [ "$avatar_valid" -eq 0 ]; then
    if [ -f "$AVATAR_TOOL" ] && command -v python3 >/dev/null 2>&1; then
        python3 "$AVATAR_TOOL" >/dev/null 2>&1 || true
    fi
    # Re-validate after running the tool
    if [ -s "$LOCK_AVATAR_CONF" ]; then
        avatar_path="$( (grep -E '^\$avatar\s*=\s*' "$LOCK_AVATAR_CONF" 2>/dev/null || true) | head -1 | sed -E 's/^\$avatar\s*=\s*//; s/[[:space:]]+$//')"
        if [ -n "$avatar_path" ] && [ -r "$avatar_path" ] && [ -s "$avatar_path" ]; then
            avatar_valid=1
        fi
    fi
fi

# Last-resort fallback: generate a minimal 1x1 PNG if nothing else worked
if [ "$avatar_valid" -eq 0 ]; then
    fallback_dir="${XDG_CACHE_HOME:-$HOME/.cache}/gps/lock"
    fallback_img="$fallback_dir/avatar-default.png"
    if [ ! -s "$fallback_img" ]; then
        mkdir -p "$fallback_dir" 2>/dev/null || true
        # Minimal valid 1x1 transparent PNG (67 bytes), base64-encoded
        printf '%s' 'iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAYAAAAfFcSJAAAADUlEQVR4nGNgYGBgAAAABQABpfZFQAAAAABJRU5ErkJggg==' \
            | base64 -d > "$fallback_img" 2>/dev/null || true
    fi
    if [ -s "$fallback_img" ]; then
        conf_dir="$(dirname "$LOCK_AVATAR_CONF")"
        mkdir -p "$conf_dir" 2>/dev/null || true
        conf_tmp="$conf_dir/.lock-avatar.tmp.$$"
        printf '%s\n' "\$avatar = $fallback_img" > "$conf_tmp" 2>/dev/null || true
        if [ -s "$conf_tmp" ]; then
            # Safe replacement: never write through a pre-existing symlink
            if [ -L "$LOCK_AVATAR_CONF" ]; then
                rm -f "$LOCK_AVATAR_CONF" 2>/dev/null || true
            fi
            mv -f "$conf_tmp" "$LOCK_AVATAR_CONF" 2>/dev/null || rm -f "$conf_tmp" 2>/dev/null
        else
            rm -f "$conf_tmp" 2>/dev/null || true
        fi
    fi
fi

# 5. Keep an owner-readable diagnostic log and report failures while the
# session is still unlocked. A successful hyprlock remains in the foreground
# until the user authenticates and exits.
LOCK_LOG_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/gps/logs"
LOCK_LOG="$LOCK_LOG_DIR/gps-lock.log"
if ! mkdir -p "$LOCK_LOG_DIR"; then
    echo "WARN: could not create lock log directory; launching hyprlock without file logging." >&2
    exec "$LOCK_BIN" --immediate-render --config "$CONFIG_FILE" "$@"
fi

if "$LOCK_BIN" --immediate-render --config "$CONFIG_FILE" "$@" >>"$LOCK_LOG" 2>&1; then
    exit 0
else
    LOCK_STATUS=$?
    echo "ERROR: hyprlock exited with status $LOCK_STATUS. Recent diagnostics:" >&2
    tail -n 40 "$LOCK_LOG" >&2 || true
    if command -v notify-send >/dev/null 2>&1; then
        notify-send -u critical "Lock Failed" "hyprlock exited with status $LOCK_STATUS. See $LOCK_LOG" || true
    fi
    exit "$LOCK_STATUS"
fi
